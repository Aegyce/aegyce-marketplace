{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "aesy-computer-technical-language",
  "version": "0.2.9",
  "description": "提供计算机技术用语 Skill，用于编写、润色和审查技术文档、代码注释与技术答复，统一术语，改进措辞，并保留已有事实、条件和不确定性。",
  "author": {
    "name": "Aegyce",
    "url": "https://github.com/Aegyce"
  },
  "repository": "https://github.com/Aegyce/agent-aesy",
  "license": "CC-BY-NC-4.0",
  "keywords": [
    "aegyce",
    "aesy",
    "technical-writing",
    "terminology"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Aesy:computer-technical-language",
        "shortDescription": "用于技术文档、代码注释与技术答复的编写、润色和审查。",
        "longDescription": "提供计算机技术用语 Skill，用于编写、润色和审查技术文档、代码注释与技术答复，统一术语，改进措辞，并保留已有事实、条件和不确定性。",
        "developerName": "Aegyce",
        "category": "Productivity",
        "websiteURL": "https://github.com/Aegyce/agent-aesy/tree/main/plugins/computer-technical-language",
        "defaultPrompt": [
          "请使用 Aesy 的计算机技术用语规范，根据我提供的信息编写技术说明，写清谁在什么条件下执行什么操作，以及操作的结果，明确尚未确定的内容。"
        ],
        "composerIcon": "./skills/computer-technical-language/assets/icon-dd925da7cc14.png",
        "logo": "./skills/computer-technical-language/assets/icon-dd925da7cc14.png",
        "brandColor": "#304D45"
      }
    }
  }
}
